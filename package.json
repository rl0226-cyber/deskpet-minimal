{
  "dependencies": {
    "pixi-live2d-display": "0.4.0",
    "pixi.js": "6.5.10"
  },
  "description": "Minimal Live2D desktop pet: gaze follows cursor, hover menu, bring-your-own OpenAI-compatible API. Clean-room rewrite, no copied app code.",
  "devDependencies": {
    "electron": "38.4.0",
    "electron-builder": "^26.0.0"
  },
  "main": "main.cjs",
  "name": "deskpet-minimal",
  "private": true,
  "scripts": {
    "selftest": "electron --no-sandbox . --selftest",
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "version": "0.1.0",
  "build": {
    "appId": "com.rl0226.deskpet",
    "productName": "DeskPet",
    "files": [
      "main.cjs",
      "preload.cjs",
      "renderer/**/*",
      "models/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
