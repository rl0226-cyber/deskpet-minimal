{
  "dependencies": {
    "pixi-live2d-display": "0.4.0",
    "pixi.js": "6.5.10"
  },
  "description": "Minimal Live2D desktop pet: gaze follows cursor, hover menu, bring-your-own OpenAI-compatible API. Clean-room rewrite, no copied app code.",
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "38.4.0"
  },
  "main": "main.cjs",
  "name": "deskpet-minimal",
  "private": true,
  "scripts": {
    "selftest": "electron --no-sandbox . --selftest",
    "start": "electron .",
    "dist": "electron-packager . DeskPet --platform=win32 --arch=x64 --out=dist --overwrite --prune --ignore=github"
  },
  "version": "0.2.1"
}
